#!/bin/bash
#
# clear-gradle-cache - Gradle のキャッシュを削除して容量を解放する
#
# 使い方:
#   clear-gradle-cache        対象一覧とサイズを表示し、y/N で確認してから削除
#   clear-gradle-cache -y     確認をスキップして即削除 (--yes も可)
#   clear-gradle-cache -h     ヘルプを表示 (--help も可)
#
# 削除されるのは再ダウンロード/再生成されるキャッシュのみ。次回ビルド時に
# 依存ライブラリや Gradle 本体が再取得されるため、初回ビルドは遅くなる。

set -euo pipefail

# 削除対象。存在しないものは自動でスキップされる。
TARGETS=(
  "$HOME/.gradle/caches"        # 依存ライブラリ・transforms・コンパイル済みスクリプト
  "$HOME/.gradle/wrapper/dists" # Gradle 本体（wrapper が再ダウンロード）
  "$HOME/.gradle/daemon"        # デーモンのログ
  "$HOME/.gradle/native"
  "$HOME/.gradle/.tmp"          # 一時ファイル
  # 以下は通常残す。容量が必要なら個別にコメントを外す。
  # "$HOME/.gradle/jdks"        # toolchain で取得した JDK（再ダウンロードは重い）
  # "$HOME/.android/build-cache"
  # "$HOME/.konan"              # Kotlin/Native の依存
)

usage() {
  cat <<'EOF'
clear-gradle-cache - Gradle のキャッシュを削除して容量を解放する

使い方:
  clear-gradle-cache        対象一覧とサイズを表示し、y/N で確認してから削除
  clear-gradle-cache -y     確認をスキップして即削除 (--yes も可)
  clear-gradle-cache -h     ヘルプを表示 (--help も可)
EOF
  exit 0
}

assume_yes=0
for arg in "$@"; do
  case "$arg" in
    -y|--yes) assume_yes=1 ;;
    -h|--help) usage ;;
    *) echo "Unknown option: $arg" >&2; exit 2 ;;
  esac
done

# Gradle デーモンが動作中だと削除中にキャッシュが破損する恐れがあるため停止する
if pgrep -f 'GradleDaemon' >/dev/null 2>&1; then
  echo "Gradle デーモンを停止します..."
  # まずグレースフルに停止（gradle が PATH にある場合）
  if command -v gradle >/dev/null 2>&1; then
    gradle --stop >/dev/null 2>&1 || true
  fi
  # 残っているデーモンプロセスを停止（複数バージョン対策）
  if pgrep -f 'GradleDaemon' >/dev/null 2>&1; then
    pkill -f 'GradleDaemon' 2>/dev/null || true
    sleep 2
  fi
  # それでも残っていれば強制終了
  if pgrep -f 'GradleDaemon' >/dev/null 2>&1; then
    pkill -9 -f 'GradleDaemon' 2>/dev/null || true
    sleep 1
  fi
  if pgrep -f 'GradleDaemon' >/dev/null 2>&1; then
    echo "警告: 一部のデーモンを停止できませんでした。" >&2
  else
    echo "Gradle デーモンを停止しました。"
  fi
fi

# 存在する対象だけ収集しつつサイズを表示
existing=()
echo "削除対象:"
for path in "${TARGETS[@]}"; do
  if [ -e "$path" ]; then
    size=$(du -sh "$path" 2>/dev/null | cut -f1)
    printf '  [%s] %s\n' "${size:-?}" "$path"
    existing+=("$path")
  else
    printf '  [skip] %s (存在しません)\n' "$path"
  fi
done

if [ "${#existing[@]}" -eq 0 ]; then
  echo "削除対象はありません。"
  exit 0
fi

if [ "$assume_yes" -ne 1 ]; then
  printf '\n上記を削除しますか? [y/N] '
  read -r reply
  case "$reply" in
    [yY]|[yY][eE][sS]) ;;
    *) echo "中止しました。"; exit 0 ;;
  esac
fi

for path in "${existing[@]}"; do
  echo "削除中: $path"
  rm -rf "$path"
done

echo "完了しました。"
